# Server-only: Shopify Headless channel private Storefront token (never an Admin API token).
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_API_VERSION=2026-10
# An existing collection containing the seven approved products, in curated order.
SHOPIFY_COLLECTION_HANDLE=
# Verified international ordering number, digits only. No default recipient.
WHATSAPP_NUMBER=
# Optional hosted customer-account URL (https://<store>.myshopify.com/account).
SHOPIFY_CUSTOMER_ACCOUNT_URL=
# For a verified custom account domain only; hostname without scheme.
SHOPIFY_CUSTOMER_ACCOUNT_HOST=
